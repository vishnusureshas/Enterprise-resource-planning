{
  "name": "erp-backend",
  "version": "1.0.0",
  "description": "ERP System Backend - Node.js, Express, PostgreSQL, Redis",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "test": "jest --coverage --forceExit",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration --forceExit",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "seed": "node seeds/run.js",
    "docker:dev": "docker compose up",
    "docker:build": "docker build -t erp-backend .",
    "cache:warm": "node scripts/warmCache.js",
    "queue:worker": "node src/jobs/worker.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "ioredis": "^5.4.1",
    "bullmq": "^5.12.2",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.2.0",
    "rate-limit-redis": "^4.2.0",
    "express-session": "^1.18.0",
    "connect-redis": "^7.1.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "dotenv": "^16.4.5",
    "multer": "^1.4.5-lts.1",
    "joi": "^17.13.1",
    "uuid": "^9.0.1",
    "dayjs": "^1.11.11",
    "lodash": "^4.17.21",
    "compression": "^1.7.4",
    "prom-client": "^15.1.3",
    "@sentry/node": "^8.15.0",
    "bull-board": "^2.1.3",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.3",
    "node-pg-migrate": "^7.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ioredis-mock": "^8.9.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}